<Window x:Class="HyperVGroupManager.App.Views.NewGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HyperVGroupManager.App.Localization"
        Title="{loc:Loc Group.NewTitle}" Height="170" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Group.NewLabel}" Margin="0,0,0,6" />
        <TextBox x:Name="GroupNameTextBox" Grid.Row="1" Margin="0,0,0,6" />
        <TextBlock Grid.Row="2" Text="{loc:Loc Group.NewHint}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc Common.Ok}" Width="80" Margin="0,0,6,0" IsDefault="True" Click="OkButton_Click" />
            <Button Content="{loc:Loc Common.Cancel}" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
