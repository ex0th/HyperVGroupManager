<Window x:Class="HyperVGroupManager.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HyperVGroupManager.App.Localization"
        Title="{loc:Loc Help.Title}" Height="650" Width="780" MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{loc:Loc Help.Title}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{loc:Loc Help.Intro}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,16" TextWrapping="Wrap" />
        <TabControl Grid.Row="2">
            <TabItem Header="{loc:Loc Help.OverviewTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="{loc:Loc Help.OverviewHeading}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Help.OverviewText}" TextWrapping="Wrap" Margin="0,8,0,22" LineHeight="22" />
                    <TextBlock Text="{loc:Loc Help.WorkflowHeading}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Help.WorkflowText}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22" />
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc Help.QuickStartTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="{loc:Loc Help.QuickStartHeading}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Help.QuickStartText}" TextWrapping="Wrap" Margin="0,8,0,22" LineHeight="22" />
                    <TextBlock Text="{loc:Loc Help.FiltersHeading}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Help.FiltersText}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22" />
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc Help.SafetyTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="{loc:Loc Help.SafetyHeading}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Help.SafetyText}" TextWrapping="Wrap" Margin="0,8,0,22" LineHeight="22" />
                    <TextBlock Text="{loc:Loc Help.RefreshHeading}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Help.RefreshText}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22" />
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc Help.ReportingTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="{loc:Loc Help.ReportingHeading}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Help.ReportingText}" TextWrapping="Wrap" Margin="0,8,0,16" LineHeight="22" />
                    <Border Style="{StaticResource CardStyle}"><TextBlock Text="{loc:Loc Help.ReportingWarning}" TextWrapping="Wrap" LineHeight="22" /></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc Help.TroubleshootingTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="{loc:Loc Help.RequirementsHeading}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Help.RequirementsText}" TextWrapping="Wrap" Margin="0,8,0,22" LineHeight="22" />
                    <TextBlock Text="{loc:Loc Help.LogsHeading}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Help.LogsText}" TextWrapping="Wrap" Margin="0,8,0,22" LineHeight="22" />
                    <TextBlock Text="{loc:Loc Help.LanguageHeading}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Help.LanguageText}" TextWrapping="Wrap" Margin="0,8,0,22" LineHeight="22" />
                    <TextBlock Text="{loc:Loc Help.ThemeHeading}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Help.ThemeText}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22" />
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Button Grid.Row="3" Content="{loc:Loc Common.Close}" Width="100" HorizontalAlignment="Right" Margin="0,14,0,0" IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
