<Window x:Class="HyperVGroupManager.App.Views.DeleteGroupConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HyperVGroupManager.App.Localization"
        Title="{loc:Loc Group.DeleteTitle}" Height="180" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="ConfirmationPanel" Grid.Row="0">
            <TextBlock TextWrapping="Wrap">
                <TextBlock Text="{loc:Loc Group.DeleteQuestionPrefix}" /><TextBlock x:Name="ConfirmGroupNameText" FontWeight="Bold" /><TextBlock Text="{loc:Loc Group.DeleteQuestionSuffix}" />
            </TextBlock>
            <TextBlock Text="{loc:Loc Group.DeleteEmpty}" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel x:Name="BlockedPanel" Grid.Row="0" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap">
                <TextBlock Text="{loc:Loc Group.DeleteBlockedPrefix}" /><TextBlock x:Name="BlockedGroupNameText" FontWeight="Bold" /><TextBlock Text="{loc:Loc Group.DeleteBlockedMiddle}" />
                <TextBlock x:Name="MemberCountText" FontWeight="Bold" /><TextBlock Text="{loc:Loc Group.DeleteBlockedSuffix}" />
            </TextBlock>
            <TextBlock Text="{loc:Loc Group.DeleteBlockedHint}" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ConfirmButton" Content="{loc:Loc Common.Delete}" Width="80" Margin="0,0,6,0" Click="ConfirmButton_Click" />
            <Button x:Name="CloseButton" Content="{loc:Loc Common.Cancel}" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
