<Window x:Class="HyperVGroupManager.App.Views.ClusterConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HyperVGroupManager.App.Localization"
        Title="{loc:Loc Common.Settings}" Height="600" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ── Tab 1: Cluster ─────────────────────────────────────────────── -->
            <TabItem Header="{loc:Loc Settings.ClusterTab}">
                <Grid Margin="12,10,12,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc Settings.CurrentPath}" FontWeight="Bold" Margin="0,0,0,4" />
                    <Border Grid.Row="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,12">
                        <TextBlock x:Name="CurrentPathTextBlock" TextWrapping="Wrap" Text="{loc:Loc Settings.Loading}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="NewPathLabel" Text="{loc:Loc Settings.NewPath}" Margin="0,0,0,4" />
                    <TextBox x:Name="PathTextBox" Grid.Row="3" Margin="0,0,0,8" />

                    <Border Grid.Row="4" x:Name="InfoBorder" BorderThickness="1" Padding="8,6">
                        <TextBlock x:Name="InfoTextBlock" TextWrapping="Wrap" FontSize="11" />
                    </Border>

                    <Button Grid.Row="5" x:Name="OkButton" Content="{loc:Loc Settings.Apply}" Width="100"
                            HorizontalAlignment="Right" Margin="0,10,0,0" Click="OkButton_Click" />
                </Grid>
            </TabItem>

            <!-- ── Tab 2: SMTP-Server ─────────────────────────────────────────── -->
            <TabItem Header="{loc:Loc Settings.SmtpTab}">
                <Grid Margin="12,10,12,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Settings.SmtpServer}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="SmtpHostTextBox" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Settings.Port}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="SmtpPortTextBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Settings.Encryption}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <RadioButton x:Name="SecurityNoneRadio" Content="{loc:Loc Settings.None}" GroupName="SmtpSec" Margin="0,0,14,0" />
                        <RadioButton x:Name="SecurityStartTlsRadio" Content="STARTTLS" GroupName="SmtpSec" Margin="0,0,14,0" IsChecked="True" />
                        <RadioButton x:Name="SecuritySslRadio"      Content="SSL/TLS"  GroupName="SmtpSec" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Settings.Authentication}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <CheckBox  Grid.Row="3" Grid.Column="1" x:Name="UseAuthCheckBox" Content="{loc:Loc Settings.Credentials}" VerticalAlignment="Center"
                               Margin="0,0,0,8" Checked="UseAuthCheckBox_Changed" Unchecked="UseAuthCheckBox_Changed" />

                    <TextBlock Grid.Row="4" Grid.Column="0" x:Name="UsernameLabel" Text="{loc:Loc Settings.Username}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="UsernameTextBox" IsEnabled="False" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="5" Grid.Column="0" x:Name="PasswordLabel" Text="{loc:Loc Settings.Password}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="PasswordBox" IsEnabled="False" />
                </Grid>
            </TabItem>

            <!-- ── Tab 3: E-Mail-Inhalt ───────────────────────────────────────── -->
            <TabItem Header="{loc:Loc Settings.EmailTab}">
                <Grid Margin="12,10,12,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Settings.SenderAddress}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="SenderAddressTextBox" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Settings.DisplayName}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="SenderDisplayNameTextBox" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Settings.Recipients}" VerticalAlignment="Top" Margin="0,4,8,0" />
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="RecipientsTextBox" Height="80"
                               AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Loc Settings.OnePerLine}"
                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Settings.BodyPrefix}" VerticalAlignment="Top" Margin="0,4,8,0" />
                    <TextBox   Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                               x:Name="BodyPrefixTextBox" Height="80"
                               AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <!-- ── Tab 4: Aufgabenplanung ─────────────────────────────────────── -->
            <TabItem Header="{loc:Loc Settings.ScheduleTab}">
                <Grid Margin="12,10,12,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Settings.Target}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TargetNameTextBox" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Settings.DailyTime}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ScheduleTimeTextBox" Width="80"
                               HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="{loc:Loc Settings.TimeTooltip}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Settings.TaskName}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TaskNameTextBlock" VerticalAlignment="Center"
                               Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                            x:Name="StatusBorder" BorderThickness="1" Padding="8,6" Margin="0,4,0,8">
                        <TextBlock x:Name="TaskStatusTextBlock" TextWrapping="Wrap" FontSize="11" />
                    </Border>

                    <WrapPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <Button x:Name="RegisterTaskButton" Content="{loc:Loc Settings.RegisterTask}" Width="150" Margin="0,0,6,0" Padding="4,3" Click="RegisterTaskButton_Click" />
                        <Button x:Name="UnregisterTaskButton" Content="{loc:Loc Settings.RemoveTask}" Width="130" Margin="0,0,6,0" Padding="4,3" Click="UnregisterTaskButton_Click" />
                        <Button x:Name="RefreshStatusButton" Content="{loc:Loc Settings.RefreshStatus}" Width="140" Padding="4,3" Click="RefreshStatusButton_Click" />
                    </WrapPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom"
                               Text="{loc:Loc Settings.ScheduleDescription}" />
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ── Schaltflächen unten ────────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SendNowButton" Content="{loc:Loc Settings.SendNow}" Width="110" Margin="0,0,6,0" Padding="4" Click="SendNowButton_Click" />
            <Button x:Name="SaveButton" Content="{loc:Loc Common.Save}" Width="90" Margin="0,0,6,0" Padding="4" Click="SaveButton_Click" />
            <Button Content="{loc:Loc Common.Close}" Width="80" IsCancel="True" Padding="4" />
        </StackPanel>
    </Grid>
</Window>
