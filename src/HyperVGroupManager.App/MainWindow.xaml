<Window x:Class="HyperVGroupManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coreServices="clr-namespace:HyperVGroupManager.Core.Services;assembly=HyperVGroupManager.Core"
        xmlns:loc="clr-namespace:HyperVGroupManager.App.Localization"
        xmlns:theming="clr-namespace:HyperVGroupManager.App.Theming"
        mc:Ignorable="d" Title="{loc:Loc App.Title}"
        Height="860" Width="1380" MinHeight="700" MinWidth="1080"
        Icon="Assets/app-icon.png" WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing" PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="24,18,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="220" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc App.Title}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{loc:Loc App.Tagline}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{loc:Loc Main.TargetLabel}" Style="{StaticResource CaptionStyle}" Margin="2,0,0,4" />
                    <TextBox Text="{Binding TargetName, UpdateSourceTrigger=PropertyChanged}" Width="230"
                             Tag="{loc:Loc Main.TargetPlaceholder}" ToolTip="{loc:Loc Main.TargetTooltip}" />
                </StackPanel>
                <Button Content="{loc:Loc Common.Connect}" Command="{Binding ConnectCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,20,8,0" />
                <Button Content="{loc:Loc Common.Refresh}" Command="{Binding RefreshCommand}" Margin="0,20,8,0" ToolTip="{loc:Loc Main.RefreshTooltip}" />
                <Button Content="{loc:Loc Common.Export}" Margin="0,20,8,0" Click="ExportConfigurationButton_Click"
                        IsEnabled="{Binding CanUseConnectedTarget}" ToolTip="{loc:Loc Main.ExportTooltip}" />
                <Button Content="{loc:Loc Common.Settings}" Margin="0,20,8,0" Click="ClusterConfigButton_Click"
                        IsEnabled="{Binding CanUseConnectedTarget}" />
                <Button Content="{loc:Loc Common.Help}" Margin="0,20,8,0" Click="HelpButton_Click" ToolTip="{loc:Loc Main.HelpTooltip}" />
                <ComboBox Margin="0,20,8,0" Width="104" ToolTip="{loc:Loc Main.LanguageTooltip}"
                          ItemsSource="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=SupportedLanguages}"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                          SelectedValue="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=CurrentLanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Margin="0,20,0,0" Width="92" ToolTip="{loc:Loc Theme.Tooltip}"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding Source={x:Static theming:ThemeService.Instance}, Path=CurrentThemeCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="{loc:Loc Theme.System}" Tag="system" />
                    <ComboBoxItem Content="{loc:Loc Theme.Dark}" Tag="dark" />
                    <ComboBoxItem Content="{loc:Loc Theme.Light}" Tag="light" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="-6,0,-6,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="6,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{loc:Loc Metric.Vms}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding VirtualMachineCount}" Style="{StaticResource MetricValueStyle}" /></StackPanel>
                    <TextBlock Grid.Column="1" Text="{loc:Loc Metric.VirtualMachines}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{loc:Loc Metric.Untagged}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding UntaggedVirtualMachineCount}" Style="{StaticResource MetricValueStyle}" /></StackPanel>
                    <TextBlock Grid.Column="1" Text="{loc:Loc Metric.ActionRequired}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{loc:Loc Metric.Groups}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding GroupCount}" Style="{StaticResource MetricValueStyle}" /></StackPanel>
                    <TextBlock Grid.Column="1" Text="{loc:Loc Metric.GroupType}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="6,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{loc:Loc Metric.Pending}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding PendingChangeCount}" Style="{StaticResource MetricValueStyle}" /></StackPanel>
                    <TextBlock Grid.Column="1" Text="{loc:Loc Metric.NotApplied}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310" MinWidth="260" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" MinWidth="560" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="16,14,16,10">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{loc:Loc Groups.Title}" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{loc:Loc Groups.Subtitle}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" /></StackPanel>
                        <Button Grid.Column="1" Content="{loc:Loc Groups.New}" Click="NewGroupButton_Click" IsEnabled="{Binding CanModifyPlan}" />
                    </Grid>
                    <TextBox Grid.Row="1" Margin="16,0,16,10" Text="{Binding GroupSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{loc:Loc Groups.SearchPlaceholder}" ToolTip="{loc:Loc Groups.SearchTooltip}" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredGroups}" SelectedItem="{Binding SelectedGroup}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="6,5" MinHeight="32">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="●" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"><TextBlock Text="{Binding MemberCount}" Style="{StaticResource CaptionStyle}" /></Border>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="{Binding EmptyGroupsMessage}"
                               Margin="24" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredGroups.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Grid.Row="3" Margin="16,10,16,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Content="{loc:Loc Common.Rename}" Click="RenameGroupButton_Click" IsEnabled="{Binding CanModifySelectedGroup}" />
                        <Button Grid.Column="2" Content="{loc:Loc Common.Delete}" Click="DeleteGroupButton_Click" IsEnabled="{Binding CanModifySelectedGroup}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="16,14,16,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{loc:Loc Vms.Title}" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{loc:Loc Vms.Subtitle}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" /></StackPanel>
                        <Button Grid.Column="1" Content="{loc:Loc Vms.Add}" Command="{Binding AddSelectedVmsToGroupCommand}" />
                        <Button Grid.Column="3" Content="{loc:Loc Vms.Remove}" Command="{Binding RemoveSelectedVmsFromGroupCommand}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="16,0,16,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{loc:Loc Vms.SearchPlaceholder}" ToolTip="{loc:Loc Vms.SearchTooltip}" />
                        <ComboBox Grid.Column="2" SelectedValue="{Binding SelectedFilterMode}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{loc:Loc Filter.All}" Tag="{x:Static coreServices:VmFilterMode.All}" />
                            <ComboBoxItem Content="{loc:Loc Filter.Untagged}" Tag="{x:Static coreServices:VmFilterMode.WithoutGroup}" />
                            <ComboBoxItem Content="{loc:Loc Filter.SelectedGroup}" Tag="{x:Static coreServices:VmFilterMode.SelectedGroup}" />
                            <ComboBoxItem Content="{loc:Loc Filter.Running}" Tag="{x:Static coreServices:VmFilterMode.Running}" />
                            <ComboBoxItem Content="{loc:Loc Filter.Off}" Tag="{x:Static coreServices:VmFilterMode.Off}" />
                        </ComboBox>
                    </Grid>
                    <DataGrid x:Name="VirtualMachinesGrid" Grid.Row="2" ItemsSource="{Binding VirtualMachineRows}"
                              AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              BorderThickness="0" Margin="1,0,1,1" SelectionChanged="VirtualMachinesGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Column.Name}" Binding="{Binding Name}" Width="2*" MinWidth="160" />
                            <DataGridTextColumn Header="{loc:Loc Column.Status}" Binding="{Binding State}" Width="110" />
                            <DataGridTextColumn Header="{loc:Loc Column.OwnerNode}" Binding="{Binding OwnerNode}" Width="150" />
                            <DataGridTemplateColumn Header="{loc:Loc Column.Groups}" Width="3*" MinWidth="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,3">
                                            <TextBlock Text="{Binding GroupNames, Converter={StaticResource StringListJoinConverter}}" />
                                            <WrapPanel Margin="0,3,0,0">
                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,5,0"
                                                        Visibility="{Binding HasAdditions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding AddedGroupsDisplay}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,5,0"
                                                        Visibility="{Binding HasRemovals, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding RemovedGroupsDisplay}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2"
                                                        Visibility="{Binding HasRenames, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding RenamedGroupsDisplay}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Column.Count}" Binding="{Binding GroupNames.Count}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding EmptyVmsMessage}"
                               Margin="30" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VirtualMachineRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="16,12,16,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Changes.Title}" Style="{StaticResource SectionTitleStyle}" />
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0"><TextBlock Text="{Binding PendingChangeCount}" Style="{StaticResource CaptionStyle}" /></Border>
                        <TextBlock Text="{loc:Loc Changes.Subtitle}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{loc:Loc Changes.Discard}" Command="{Binding DiscardChangesCommand}" />
                    <Button Grid.Column="3" Content="{loc:Loc Changes.Apply}" Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding CanApplyChanges}" Click="ApplyChangesButton_Click" />
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding PendingChanges}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Column.Action}" Binding="{Binding ChangeType, Converter={StaticResource ChangeTypeToGermanConverter}}" Width="155" />
                        <DataGridTextColumn Header="{loc:Loc Column.Vm}" Binding="{Binding VmName}" Width="180" />
                        <DataGridTextColumn Header="{loc:Loc Column.Group}" Binding="{Binding GroupName}" Width="220" />
                        <DataGridTextColumn Header="{loc:Loc Column.Description}" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" Text="{loc:Loc Changes.Empty}"
                           TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingChanges.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnectionError}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc Status.Target}" Style="{StaticResource CaptionStyle}" />
                <TextBlock Text="{Binding ConnectedTargetName}" Style="{StaticResource CaptionStyle}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding StatusMessages[0]}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="0,0,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Style="{StaticResource CaptionStyle}"><Run Text="{loc:Loc Status.LastRefresh}" /><Run Text="{Binding LastRefreshedAtDisplay, Mode=OneWay}" /></TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
